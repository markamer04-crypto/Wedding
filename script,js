document.addEventListener('DOMContentLoaded', () => {
  const canvas = document.getElementById('rope-canvas');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  const instruction = document.getElementById('instruction');

  let width, height;
  let points = [];
  const numPoints = 80; // Smoothness of the heart loop
  let draggedPoint = null;
  let isRevealed = false;
  let dragDistance = 0;
  const pullThreshold = 220; // How far you must pull before it unlocks

  // Lock scrolling on page load
  document.body.classList.add('rope-locked');

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    if (!isRevealed && points.length === 0) {
      initHeartRope();
    }
  }

  // Generates heart shape points using parametric heart formula
  function initHeartRope() {
    points = [];
    const centerX = width / 2;
    const centerY = height / 2 - 20;
    const scale = Math.min(width, height) / 35;

    for (let i = 0; i < numPoints; i++) {
      const t = (i / numPoints) * Math.PI * 2;
      const x = 16 * Math.pow(Math.sin(t), 3);
      const y = -(13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t));

      const posX = centerX + x * scale;
      const posY = centerY + y * scale;

      points.push({
        x: posX,
        y: posY,
        ox: posX,
        oy: posY,
        vx: 0,
        vy: 0
      });
    }
  }

  function getPointerPos(e) {
    const rect = canvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return {
      x: clientX - rect.left,
      y: clientY - rect.top
    };
  }

  function onPointerDown(e) {
    if (isRevealed) return;
    const pos = getPointerPos(e);

    let minDist = Infinity;
    points.forEach(p => {
      const dist = Math.hypot(p.x - pos.x, p.y - pos.y);
      if (dist < minDist) {
        minDist = dist;
        draggedPoint = p;
      }
    });

    if (minDist > 60) {
      draggedPoint = null;
    }
  }

  function onPointerMove(e) {
    if (!draggedPoint || isRevealed) return;
    const pos = getPointerPos(e);

    draggedPoint.x = pos.x;
    draggedPoint.y = pos.y;

    dragDistance = Math.hypot(draggedPoint.x - draggedPoint.ox, draggedPoint.y - draggedPoint.oy);

    // If pulled past the threshold distance, unlock the site
    if (dragDistance > pullThreshold) {
      revealWebsite();
    }
  }

  function onPointerUp() {
    draggedPoint = null;
    dragDistance = 0;
  }

  // Spring physics simulation for realistic rope bouncing
  function updateRopePhysics() {
    if (isRevealed) return;

    const stiffness = 0.08;
    const damping = 0.82;

    for (let i = 0; i < points.length; i++) {
      const p = points[i];

      if (p !== draggedPoint) {
        const fx = (p.ox - p.x) * stiffness;
        const fy = (p.oy - p.y) * stiffness;

        p.vx = (p.vx + fx) * damping;
        p.vy = (p.vy + fy) * damping;

        p.x += p.vx;
        p.y += p.vy;
      }
    }

    // Keep rope segment distances consistent
    for (let i = 0; i < points.length; i++) {
      const p1 = points[i];
      const p2 = points[(i + 1) % points.length];

      const dx = p2.x - p1.x;
      const dy = p2.y - p1.y;
      const dist = Math.hypot(dx, dy);
      const targetDist = 12;

      if (dist > targetDist) {
        const factor = (dist - targetDist) / dist * 0.3;
        const offsetX = dx * factor;
        const offsetY = dy * factor;

        if (p1 !== draggedPoint) { p1.x += offsetX; p1.y += offsetY; }
        if (p2 !== draggedPoint) { p2.x -= offsetX; p2.y -= offsetY; }
      }
    }
  }

  // Renders the heart rope on the HTML canvas
  function drawRope() {
    ctx.clearRect(0, 0, width, height);

    if (isRevealed || points.length === 0) return;

    // Main Outer Rope Strand
    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length; i++) {
      ctx.lineTo(points[i].x, points[i].y);
    }
    ctx.closePath();

    ctx.lineWidth = 18;
    ctx.strokeStyle = '#d84315';
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();

    // Inner Highlight Strand
    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length; i++) {
      ctx.lineTo(points[i].x, points[i].y);
    }
    ctx.closePath();

    ctx.lineWidth = 8;
    ctx.strokeStyle = '#ff7043';
    ctx.stroke();
  }

  function animate() {
    updateRopePhysics();
    drawRope();
    requestAnimationFrame(animate);
  }

  function revealWebsite() {
    isRevealed = true;
    draggedPoint = null;

    canvas.classList.add('hidden');
    if (instruction) instruction.style.opacity = '0';

    // Enable scrolling again
    document.body.classList.remove('rope-locked');
  }

  // Listeners for desktop and mobile touch interaction
  window.addEventListener('resize', resize);
  canvas.addEventListener('mousedown', onPointerDown);
  window.addEventListener('mousemove', onPointerMove);
  window.addEventListener('mouseup', onPointerUp);

  canvas.addEventListener('touchstart', onPointerDown);
  window.addEventListener('touchmove', onPointerMove);
  window.addEventListener('touchend', onPointerUp);

  resize();
  animate();
});
